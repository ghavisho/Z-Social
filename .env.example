# === Z — Environment Variables (EXAMPLE) ===
# این فایل را کپی کن به .env.local و مقادیر واقعی را قرار بده.
# هرگز .env.local را داخل Git یا ZIP منتشر نکن.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # فقط سمت سرور، هرگز به کلاینت ارسال نشود

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Z

# --- Initial Super Admin (فقط برای اولین اجرا؛ بعد از تغییر رمز نیاز نیست) ---
INITIAL_ADMIN_USERNAME=admin1234
INITIAL_ADMIN_PASSWORD=4321nimda

# --- Session / Auth ---
SESSION_SECRET=replace-with-a-long-random-string

# --- Optional: AI (اختیاری — اگر خالی باشد، Z بدون AI هم کار می‌کند) ---
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_MODEL=gpt-4o-mini

# --- Optional: "Update Z" from the admin panel (upload a ZIP, auto-deploy) ---
# Without the first three, the /admin/deploy page still exists but shows a
# setup notice instead of the uploader. This pushes straight to GitHub, so
# it works no matter which host (Netlify, Vercel, Cloudflare Pages...) is
# connected to auto-deploy from that repo. See README section
# "به‌روزرسانی از پنل ادمین" for how to get each value.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# Optional — only if you want the admin panel to show live Netlify build
# status instead of just "pushed, check your dashboard":
NETLIFY_TOKEN=
NETLIFY_SITE_ID=

# --- Optional: Realtime Voice/Video (WebRTC STUN/TURN) ---
# اگر خالی بمانند، Z خودکار از یک TURN رایگان و عمومی (openrelay.metered.ca)
# به‌عنوان جایگزین استفاده می‌کند — رایگان ولی مشترک بین همه (Rate Limit دارد).
# برای استفاده‌ی واقعی، این‌ها را با یک TURN اختصاصی (مثل Twilio/Xirsys) پر کن.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
